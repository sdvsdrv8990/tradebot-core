rule RERUN_CMAKE
  command = /home/admin/projects/tradebot-core/.deps/venv/lib/python3.14/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/admin/projects/tradebot-core -B/home/admin/projects/tradebot-core/.build-asan
  description = Re-running CMake...
  generator = 1


